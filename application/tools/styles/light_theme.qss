/* FILE: application/tools/styles/light_theme.qss */

/* Base font and defaults */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* Specific styling for the EditorWindow (QMainWindow) */
QMainWindow#EditorWindow {
    background-color: #f4f5f8;
    color: #1f2024;
}

/* Scoped panels */
QWidget#LeftNavPane,
QWidget#CenterInspectorPane,
QWidget#RightPreviewPane,
QWidget#ProblemsDrawer,
QWidget#AssetHub {
    background-color: #ffffff;
    border: 1px solid #dcdde2;
    border-radius: 6px;
}

/* Base text color for labels inside panes */
QLabel {
    color: #1f2024;
    background-color: transparent;
    font-size: 10pt;
}

/* Typography and Inspector Header Rules */
QLabel#InspectorTitle {
    font-size: 14pt;
    font-weight: bold;
    color: #1f2024;
}

QLabel#InspectorBadge {
    font-size: 9pt;
    font-weight: bold;
    color: #2d55b8;
    background-color: rgba(56, 103, 214, 0.1);
    border: 1px solid #3867d6;
    border-radius: 4px;
    padding: 2px 6px;
}

QLabel#InspectorBreadcrumbs {
    font-size: 9pt;
    color: #6b6d7c;
}

QLabel#InspectorStatus {
    font-size: 9pt;
    font-weight: 600;
}

/* QDockWidget Styling */
QDockWidget {
    color: #1f2024;
}

QDockWidget::title {
    text-align: left;
    background-color: #eaebf0;
    padding: 6px 10px;
    border: 1px solid #dcdde2;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: bold;
    font-size: 10pt;
}

/* Line Edits and Text Edits */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1f2024;
    border: 1px solid #cfd0d8;
    padding: 6px 8px;
    border-radius: 4px;
    selection-background-color: #3867d6;
    selection-color: #ffffff;
    font-size: 10pt;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #3867d6;
    background-color: #ffffff;
}

/* Dynamic Property-Based Error Styling */
QLineEdit[hasError="true"], QTextEdit[hasError="true"], QPlainTextEdit[hasError="true"], QComboBox[hasError="true"] {
    border: 1.5px solid #d32f2f !important;
    background-color: rgba(211, 47, 47, 0.08) !important;
}

/* Fallback for legacy inline style overrides */
QLineEdit[style*="border: 1px solid red;"], QTextEdit[style*="border: 1px solid red;"] {
    border: 1.5px solid #d32f2f !important;
    background-color: rgba(211, 47, 47, 0.08) !important;
}

/* Combo Boxes */
QComboBox {
    background-color: #ffffff;
    color: #1f2024;
    border: 1px solid #cfd0d8;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    font-size: 10pt;
}

QComboBox:hover {
    border: 1px solid #3867d6;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2024;
    selection-background-color: #3867d6;
    selection-color: #ffffff;
    border: 1px solid #cfd0d8;
}

/* Push Buttons */
QPushButton {
    background-color: #eaebf0;
    color: #1f2024;
    border: 1px solid #cfd0d8;
    border-radius: 4px;
    padding: 5px 12px;
    font-weight: 500;
    font-size: 10pt;
}

QPushButton:hover {
    background-color: #dfe1e8;
    border: 1px solid #3867d6;
}

QPushButton:pressed {
    background-color: #d2d4de;
}

QPushButton:disabled {
    background-color: #f2f3f6;
    color: #a0a2ad;
    border: 1px solid #e0e1e6;
}

/* Primary/Accent Action Buttons */
QPushButton#primaryAction, QPushButton[primary="true"], QToolButton[primary="true"] {
    background-color: #3867d6;
    border: 1px solid #2d55b8;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#primaryAction:hover, QPushButton[primary="true"]:hover, QToolButton[primary="true"]:hover {
    background-color: #2d55b8;
}

/* Filter Chips */
QPushButton[isChip="true"] {
    background-color: #eaebf0;
    border: 1px solid #cfd0d8;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
}

QPushButton[isChip="true"]:checked {
    background-color: #3867d6;
    border-color: #2d55b8;
    color: #ffffff;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #cfd0d8;
    border-radius: 6px;
    margin-top: 1.2ex;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    margin-left: 10px;
    background-color: #ffffff;
    color: #555762;
}

/* QTreeWidget and QListWidget */
QTreeWidget, QListWidget, QTableView {
    background-color: #ffffff;
    color: #1f2024;
    border: 1px solid #dcdde2;
    alternate-background-color: #f8f9fb;
    selection-background-color: #3867d6;
    selection-color: #ffffff;
    border-radius: 6px;
    outline: none;
}

QTreeWidget::item, QListWidget::item {
    padding: 4px 6px;
    border-radius: 3px;
    min-height: 24px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #edf2ff;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #3867d6;
    color: #ffffff;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid #dcdde2;
    background-color: #ffffff;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #eaebf0;
    color: #555762;
    border: 1px solid #dcdde2;
    border-bottom: none;
    padding: 7px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1f2024;
    border-bottom: 2px solid #3867d6;
}

QTabBar::tab:hover:!selected {
    background-color: #dfe1e8;
}

/* Splitter */
QSplitter::handle {
    background-color: #dcdde2;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/* Menus and Menu Bar */
QMenuBar {
    background-color: #eaebf0;
    color: #1f2024;
    border-bottom: 1px solid #dcdde2;
}

QMenuBar::item:selected {
    background-color: #3867d6;
    color: #ffffff;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #cfd0d8;
    color: #1f2024;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #3867d6;
    color: #ffffff;
}

/* Tool Bar */
QToolBar {
    background-color: #eaebf0;
    border-bottom: 1px solid #dcdde2;
    padding: 3px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 4px 8px;
    border-radius: 4px;
    color: #1f2024;
}

QToolButton:hover {
    background-color: #dfe1e8;
    border: 1px solid #cfd0d8;
}

QToolButton:pressed {
    background-color: #cfd0d8;
}

/* Status Bar */
QStatusBar {
    background-color: #eaebf0;
    color: #555762;
    border-top: 1px solid #dcdde2;
}
