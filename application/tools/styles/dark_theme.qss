/* FILE: application/tools/styles/dark_theme.qss */

/* Base font and defaults */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* Specific styling for the EditorWindow (QMainWindow) */
QMainWindow#EditorWindow {
    background-color: #1b1b22;
    color: #e2e2e8;
}

/* Clean panel styling without cascading transparency */
QWidget#LeftNavPane,
QWidget#CenterInspectorPane,
QWidget#RightPreviewPane,
QWidget#ProblemsDrawer,
QWidget#AssetHub {
    background-color: #23232c;
    border: 1px solid #32323e;
    border-radius: 6px;
}

/* Base text color for labels inside panes */
QLabel {
    color: #e2e2e8;
    background-color: transparent;
    font-size: 10pt;
}

/* Typography and Inspector Header Rules */
QLabel#InspectorTitle {
    font-size: 14pt;
    font-weight: bold;
    color: #ffffff;
}

QLabel#InspectorBadge {
    font-size: 9pt;
    font-weight: bold;
    color: #4b7bec;
    background-color: rgba(75, 123, 236, 0.15);
    border: 1px solid #3867d6;
    border-radius: 4px;
    padding: 2px 6px;
}

QLabel#InspectorBreadcrumbs {
    font-size: 9pt;
    color: #9d9daf;
}

QLabel#InspectorStatus {
    font-size: 9pt;
    font-weight: 600;
}

/* QDockWidget Styling */
QDockWidget {
    color: #e2e2e8;
}

QDockWidget::title {
    text-align: left;
    background-color: #23232c;
    padding: 6px 10px;
    border: 1px solid #32323e;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: bold;
    font-size: 10pt;
}

/* Line Edits and Text Edits */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #18181f;
    color: #f2f2f6;
    border: 1px solid #3c3c4a;
    padding: 6px 8px;
    border-radius: 4px;
    selection-background-color: #3867d6;
    selection-color: #ffffff;
    font-size: 10pt;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #4b7bec;
    background-color: #1c1c24;
}

/* Dynamic Property-Based Error Styling */
QLineEdit[hasError="true"], QTextEdit[hasError="true"], QPlainTextEdit[hasError="true"], QComboBox[hasError="true"] {
    border: 1.5px solid #ff5252 !important;
    background-color: rgba(255, 82, 82, 0.12) !important;
}

/* Fallback for legacy inline style overrides */
QLineEdit[style*="border: 1px solid red;"], QTextEdit[style*="border: 1px solid red;"] {
    border: 1.5px solid #ff5252 !important;
    background-color: rgba(255, 82, 82, 0.12) !important;
}

/* Combo Boxes */
QComboBox {
    background-color: #282834;
    color: #e2e2e8;
    border: 1px solid #3c3c4a;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    font-size: 10pt;
}

QComboBox:hover {
    border: 1px solid #4b7bec;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
}

QComboBox QAbstractItemView {
    background-color: #23232c;
    color: #e2e2e8;
    selection-background-color: #3867d6;
    selection-color: #ffffff;
    border: 1px solid #3c3c4a;
}

/* Push Buttons */
QPushButton {
    background-color: #2e2e3b;
    color: #ffffff;
    border: 1px solid #424254;
    border-radius: 4px;
    padding: 5px 12px;
    font-weight: 500;
    font-size: 10pt;
}

QPushButton:hover {
    background-color: #383848;
    border: 1px solid #4b7bec;
}

QPushButton:pressed {
    background-color: #202029;
}

QPushButton:disabled {
    background-color: #1e1e26;
    color: #727284;
    border: 1px solid #2e2e3a;
}

/* Primary/Accent Action Buttons */
QPushButton#primaryAction, QPushButton[primary="true"], QToolButton[primary="true"] {
    background-color: #3867d6;
    border: 1px solid #4b7bec;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#primaryAction:hover, QPushButton[primary="true"]:hover, QToolButton[primary="true"]:hover {
    background-color: #4b7bec;
}

/* Filter Chips */
QPushButton[isChip="true"] {
    background-color: #282834;
    border: 1px solid #3c3c4a;
    border-radius: 12px;
    padding: 3px 10px;
    font-size: 11px;
}

QPushButton[isChip="true"]:checked {
    background-color: #3867d6;
    border-color: #4b7bec;
    color: #ffffff;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #343442;
    border-radius: 6px;
    margin-top: 1.2ex;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    margin-left: 10px;
    background-color: #23232c;
    color: #a5a5b8;
}

/* QTreeWidget and QListWidget */
QTreeWidget, QListWidget, QTableView {
    background-color: #1a1a22;
    color: #e2e2e8;
    border: 1px solid #32323e;
    alternate-background-color: #1e1e28;
    selection-background-color: #3867d6;
    selection-color: #ffffff;
    border-radius: 6px;
    outline: none;
}

QTreeWidget::item, QListWidget::item {
    padding: 4px 6px;
    border-radius: 3px;
    min-height: 24px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #262634;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #3867d6;
    color: #ffffff;
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid #32323e;
    background-color: #23232c;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #1c1c24;
    color: #9d9daf;
    border: 1px solid #32323e;
    border-bottom: none;
    padding: 7px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #23232c;
    color: #ffffff;
    border-bottom: 2px solid #3867d6;
}

QTabBar::tab:hover:!selected {
    background-color: #282834;
    color: #e2e2e8;
}

/* Splitter */
QSplitter::handle {
    background-color: #2d2d3a;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/* Menus and Menu Bar */
QMenuBar {
    background-color: #1e1e26;
    color: #d6d6e2;
    border-bottom: 1px solid #2d2d3a;
}

QMenuBar::item:selected {
    background-color: #3867d6;
    color: #ffffff;
}

QMenu {
    background-color: #23232c;
    border: 1px solid #3c3c4a;
    color: #e2e2e8;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #3867d6;
    color: #ffffff;
}

/* Tool Bar */
QToolBar {
    background-color: #1e1e26;
    border-bottom: 1px solid #2d2d3a;
    padding: 3px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 4px 8px;
    border-radius: 4px;
    color: #e2e2e8;
}

QToolButton:hover {
    background-color: #2e2e3b;
    border: 1px solid #3c3c4a;
}

QToolButton:pressed {
    background-color: #181820;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: #1a1a22;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #3a3a4a;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4e4e64;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1a1a22;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #3a3a4a;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4e4e64;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #181820;
    color: #9d9daf;
    border-top: 1px solid #2d2d3a;
}

/* Course cards (QFrame-based CourseCardWidget) */
QFrame#course_card {
    background-color: #23232c;
    border: 1px solid #32323e;
    border-radius: 6px;
}

QFrame#course_card:hover {
    background-color: #282834;
    border: 1px solid #4b7bec;
}

QFrame#course_card:focus {
    border: 1px solid #4b7bec;
}

QFrame#course_card[pressed="true"] {
    background-color: #202029;
    border: 1px solid #4b7bec;
}

/* Scoped child typography so card states never bleed into labels */
QLabel#course_card_title {
    font-size: 12pt;
    font-weight: bold;
    color: #ffffff;
    background-color: transparent;
}

QLabel#course_card_description {
    color: #9d9daf;
    background-color: transparent;
}

QLabel#course_card_metadata {
    font-size: 9pt;
    color: #e2e2e8;
    background-color: transparent;
}
